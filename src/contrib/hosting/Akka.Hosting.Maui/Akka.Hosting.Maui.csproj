<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Description>Akka.Hosting support for .NET MAUI applications. Starts the ActorSystem from a MAUI initializer, because MAUI does not run IHostedService instances.</Description>
        <!-- Plain net10.0 on purpose: IMauiInitializeService lives in Microsoft.Maui.Core, which ships a net10.0
             asset, so this project builds on any agent without the MAUI workloads. A MAUI app consuming it
             restores Microsoft.Maui.Core for its own platform TFM, and the types bind by assembly name. -->
        <TargetFramework>$(NetStandardLibVersion)</TargetFramework>
        <Nullable>enable</Nullable>
        <IsAotCompatible>true</IsAotCompatible>
        <PackageTags>$(AkkaPackageTags);hosting;maui</PackageTags>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <PackageProjectUrl>https://getakka.net/articles/hosting/index.html</PackageProjectUrl>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Core" Version="$(MauiCoreVersion)" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Akka.Hosting\Akka.Hosting.csproj" />
    </ItemGroup>

</Project>
