<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(NetStandardLibVersion);net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Compatibility package for SQL Server, PostgreSQL, and SQLite storage in Akka.Reminders.</Description>
    <PackageTags>$(AkkaPackageTags);reminders;sql;sqlserver;postgresql;sqlite;compatibility</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Akka.Reminders\Akka.Reminders.csproj" />
    <ProjectReference Include="..\Akka.Reminders.SqlServer\Akka.Reminders.SqlServer.csproj" />
    <ProjectReference Include="..\Akka.Reminders.PostgreSql\Akka.Reminders.PostgreSql.csproj" />
    <ProjectReference Include="..\Akka.Reminders.Sqlite\Akka.Reminders.Sqlite.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == '$(NetStandardLibVersion)'">
    <PackageReference Include="Polyfill" Version="1.28.0" PrivateAssets="all" />
    <Compile Remove="$(NuGetPackageRoot)polyfill/1.28.0/contentFiles/cs/netstandard2.0/Polyfill/Nullability/**" />
  </ItemGroup>

</Project>
