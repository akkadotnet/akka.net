<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(NetStandardLibVersion);net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Akka.Reminders.SqlServer</PackageId>
    <Description>SQL Server storage implementation for Akka.Reminders.</Description>
    <PackageTags>$(AkkaPackageTags);reminders;sql;sqlserver</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Akka.Reminders\Akka.Reminders.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Akka.Event" />
  </ItemGroup>

  <ItemGroup>
    <!-- Transitive security pin (NuGet audit): Microsoft.Data.SqlClient 6.1.4 depends on
         System.Security.Cryptography.Pkcs 9.0.11; GHSA-2fmv-rv2c-59x7 and GHSA-846f-f764-76mx
         are fixed in 9.0.21. Remove once SqlClient ships a patched dependency. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="9.0.21" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Scripts\SqlServer-Create.sql" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == '$(NetStandardLibVersion)'">
    <PackageReference Include="Polyfill" Version="1.28.0" PrivateAssets="all" />
    <Compile Remove="$(NuGetPackageRoot)polyfill/1.28.0/contentFiles/cs/netstandard2.0/Polyfill/Nullability/**" />
  </ItemGroup>

  <!-- SqlClient 6.1's netstandard2.0 asset is only a compatibility surface;
       5.2 supplies runnable drivers for .NET 6/7 consumers of this target. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.3" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.4" />
  </ItemGroup>

</Project>
