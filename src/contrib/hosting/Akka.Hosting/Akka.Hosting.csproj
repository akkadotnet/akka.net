<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Description>Akka.NET Microsoft.Extensions.Hosting support.</Description>
        <TargetFramework>$(NetStandardLibVersion)</TargetFramework>
        <Nullable>enable</Nullable>
        <PackageTags>$(AkkaPackageTags);hosting;dependency injection</PackageTags>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <PackageProjectUrl>https://getakka.net/articles/hosting/index.html</PackageProjectUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <!-- Drop the repo-root README that Directory.Build.props packs into every package,
             then pack this module's own README in its place. -->
        <None Remove="$([System.IO.Path]::GetDirectoryName($(DirectoryBuildPropsPath)))/README.md" />
        <None Update="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="$(MsExtVersion)" />
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="$(MsExtVersion)" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="$(MsExtVersion)" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="$(MsExtVersion)" />
        <PackageReference Include="OpenTelemetry" Version="$(OpenTelemetryVersion)" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\dependencyinjection\Akka.DependencyInjection\Akka.DependencyInjection.csproj" />
        <ProjectReference Include="..\..\..\core\Akka.Streams\Akka.Streams.csproj" />
    </ItemGroup>

</Project>
