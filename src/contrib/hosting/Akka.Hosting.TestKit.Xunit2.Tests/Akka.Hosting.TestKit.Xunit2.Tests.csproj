<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>$(TestsNetCoreFramework)</TargetFramework>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\Akka.Hosting.TestKit.Xunit2\Akka.Hosting.TestKit.Xunit2.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Compile Include="..\Akka.Hosting.TestKit.Tests\DiPropsFailTest.cs">
        <Link>DiPropsFailTest.cs</Link>
      </Compile>
      <Compile Include="..\Akka.Hosting.TestKit.Tests\HostingSpecSpec.cs">
        <Link>HostingSpecSpec.cs</Link>
      </Compile>
      <Compile Include="..\Akka.Hosting.TestKit.Tests\LoggerSpec.cs">
        <Link>LoggerSpec.cs</Link>
      </Compile>
      <Compile Include="..\Akka.Hosting.TestKit.Tests\NoImplicitSenderSpec.cs">
        <Link>NoImplicitSenderSpec.cs</Link>
      </Compile>
      <Compile Include="..\Akka.Hosting.TestKit.Tests\TestActorStartupDeadlockSpec.cs">
        <Link>TestActorStartupDeadlockSpec.cs</Link>
      </Compile>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="$(MicrosoftExtensionsVersion)" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="$(TestSdkVersion)" />
        <PackageReference Include="xunit" Version="$(XunitVersion)" />
        <PackageReference Include="FluentAssertions" Version="6.12.2" />
        <PackageReference Include="xunit.runner.visualstudio" Version="$(XunitRunneVisualstudio)">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
      <None Update="xunit.runner.json">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
    </ItemGroup>
    
</Project>
