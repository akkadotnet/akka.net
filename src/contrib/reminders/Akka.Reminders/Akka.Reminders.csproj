<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>$(NetStandardLibVersion);net10.0</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Description>Durable, re-entrant reminders system for Akka.Cluster.Sharding.</Description>
        <PackageTags>$(AkkaPackageTags);cluster;sharding;reminders;scheduling</PackageTags>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
      <InternalsVisibleTo Include="Akka.Reminders.Tests" />
    </ItemGroup>

    <ItemGroup>
      <Using Include="Akka.Event" />
    </ItemGroup>

    <ItemGroup>
      <!-- Ship this module's README instead of the repo-root one that
           Directory.Build.props packs into every package. -->
      <None Remove="$([System.IO.Path]::GetDirectoryName($(DirectoryBuildPropsPath)))/README.md" />
      <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\hosting\Akka.Cluster.Hosting\Akka.Cluster.Hosting.csproj" />
    </ItemGroup>

    <!-- netstandard2.0 lacks records/init (IsExternalInit) and the .NET 7+ AOT
         annotations. Polyfill supplies them as source; compile-only.
         The Nullability polyfills are excluded: this module never uses
         NullabilityInfoContext, and Polyfill's copy collides with the global
         Akka.Event using on the unqualified Debug reference. -->
    <ItemGroup Condition="'$(TargetFramework)' == '$(NetStandardLibVersion)'">
      <PackageReference Include="Polyfill" Version="1.28.0" PrivateAssets="all" />
      <Compile Remove="$(NuGetPackageRoot)polyfill/1.28.0/contentFiles/cs/netstandard2.0/Polyfill/Nullability/**" />
    </ItemGroup>

</Project>
