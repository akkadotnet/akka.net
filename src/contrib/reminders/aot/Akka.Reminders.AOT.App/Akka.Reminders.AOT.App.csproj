<Project Sdk="Microsoft.NET.Sdk">

  <!-- Native AOT canary for local-mode reminders. Not packed. CI publishes it with
       PublishAot on linux-x64, runs it, and checks ILC's warnings against
       aot-warnings.baseline.txt (see check-aot-warnings.sh). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>

    <!-- The app's own C# is analyzed on every build, so it stays trim/AOT clean. -->
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>

    <!-- ILC's IL2xxx/IL3xxx list is what the CI check reads, so ILC warnings must not fail the
         publish. The app's own C# still builds with TreatWarningsAsErrors. -->
    <IlcTreatWarningsAsErrors>false</IlcTreatWarningsAsErrors>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>

    <!-- Microsoft.Data.Sqlite ships satellite resource assemblies. With InvariantGlobalization=true,
         Akka.Hosting 1.6.0-beta2 crashes in its MAUI detection when satellites are present; keeping
         only English satellites avoids that. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- PublishAot only with a RuntimeIdentifier, so a plain solution build does not restore a
       RID-specific ILCompiler. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Akka.Reminders\Akka.Reminders.csproj" />
    <ProjectReference Include="..\..\Akka.Reminders.Sqlite\Akka.Reminders.Sqlite.csproj" />
  </ItemGroup>

  <!-- Turn Akka.DynamicTypeLoading off for every run, including `dotnet run` on the JIT, so the
       canary always exercises the reflection-free paths. The Akka NuGet package does this for
       AOT publishes on its own; declaring it here makes the JIT run strict too. -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="Akka.DynamicTypeLoading" Value="false" Trim="true" />
  </ItemGroup>

</Project>
