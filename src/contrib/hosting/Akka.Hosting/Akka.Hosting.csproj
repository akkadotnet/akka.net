<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Description>Akka.NET Microsoft.Extensions.Hosting support.</Description>
        <TargetFrameworks>$(NetStandardLibVersion);$(NetLibVersion)</TargetFrameworks>
        <Nullable>enable</Nullable>
        <PackageTags>$(AkkaPackageTags);hosting;dependency injection</PackageTags>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <PackageProjectUrl>https://getakka.net/articles/hosting/index.html</PackageProjectUrl>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="$(MsExtHostingVersion)" />
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="$(MsExtHostingVersion)" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="$(MsExtHostingVersion)" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="$(MsExtHostingVersion)" />
        <PackageReference Include="OpenTelemetry" Version="$(OpenTelemetryVersion)" />
        <!-- Keep GHSA-g94r-2vxg-569j patched while allowing the Microsoft.Extensions 9-compatible SDK. -->
        <PackageReference Include="OpenTelemetry.Api" Version="[1.15.3,)" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\dependencyinjection\Akka.DependencyInjection\Akka.DependencyInjection.csproj" />
        <ProjectReference Include="..\..\..\core\Akka.Streams\Akka.Streams.csproj" />
    </ItemGroup>

</Project>
