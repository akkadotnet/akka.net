<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Description>Akka.Persistence Microsoft.Extensions.Hosting support.</Description>
        <TargetFramework>$(NetStandardLibVersion)</TargetFramework>
        <Nullable>enable</Nullable>
        <PackageTags>$(AkkaPackageTags);hosting;persistence;event sourcing</PackageTags>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <PackageProjectUrl>https://getakka.net/articles/hosting/index.html</PackageProjectUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <!-- Drop the repo-root README that Directory.Build.props packs into every package,
             then pack this module's own README in its place. -->
        <None Remove="$([System.IO.Path]::GetDirectoryName($(DirectoryBuildPropsPath)))/README.md" />
        <None Update="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Akka.Hosting\Akka.Hosting.csproj" />
        <ProjectReference Include="..\..\..\core\Akka.Persistence\Akka.Persistence.csproj" />
        <ProjectReference Include="..\..\..\core\Akka.Persistence.Query\Akka.Persistence.Query.csproj" />
    </ItemGroup>

</Project>
